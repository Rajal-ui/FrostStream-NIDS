# FrostStream NIDS - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# =============================================================================
# EXECUTION MODE
# =============================================================================
# Set to LOCAL for offline development (default), CLOUD for production deployment
EXECUTION_MODE=LOCAL

# =============================================================================
# SNOWFLAKE CREDENTIALS (Required for CLOUD mode)
# =============================================================================
# Get these from your Snowflake account administrator
SNOWFLAKE_ACCOUNT=your-account-identifier  # e.g., xy12345.us-east-1 or org-account
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password           # OR use key-pair auth below
SNOWFLAKE_PRIVATE_KEY_PATH=                # Path to RSA private key (key-pair auth recommended for CI/CD)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=          # Passphrase for private key (if encrypted)
SNOWFLAKE_ROLE=ACCOUNTADMIN                # Or custom role with required privileges
SNOWFLAKE_DATABASE=FROSTSTREAM_NIDS
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_WAREHOUSE=NIDS_ANALYTICS_WH      # Or NIDS_INGEST_WH for ingestion tasks

# =============================================================================
# AWS CREDENTIALS (Required for CLOUD mode)
# =============================================================================
# Configure via AWS CLI: `aws configure` or set these directly
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# VPC/Network parameters for SOAR mitigation
TARGET_VPC_ID=vpc-0a1b2c3d4e5f6g7h8
TARGET_NACL_ID=acl-0123456789abcdef0

# S3 Landing Bucket for Flow Logs (Kinesis Firehose -> S3 -> Snowpipe)
S3_FLOW_BUCKET=froststream-nids-flows-123456789012-us-east-1

# =============================================================================
# KINESIS FIREHOSE (Cloud mode ingestion)
# =============================================================================
FIREHOSE_DELIVERY_STREAM_NAME=froststream-nids-flows

# =============================================================================
# LOCAL MODE SETTINGS (Used when EXECUTION_MODE=LOCAL)
# =============================================================================
# Local model storage directory
LOCAL_MODEL_DIR=storage/models

# Local flow capture output
LOCAL_FLOW_OUTPUT=storage/captured_flows.csv

# Local SQLite alert database
LOCAL_ALERT_DB=storage/alerts.db

# Scapy interface for live capture (Windows: use Npcap interface name/guid)
# Leave empty for offline PCAP replay mode
SCAPY_INTERFACE=

# =============================================================================
# MODEL SETTINGS
# =============================================================================
# Confidence threshold for alerting
CONFIDENCE_THRESHOLD=0.90

# Critical severity threshold
CRITICAL_CONFIDENCE_THRESHOLD=0.95

# IsolationForest anomaly threshold for zero-day detection
ANOMALY_THRESHOLD=-0.2

# PSI drift threshold
PSI_DRIFT_THRESHOLD=0.25

# =============================================================================
# SOAR SETTINGS
# =============================================================================
# NACL rule number range for FrostStream managed rules
NACL_RULE_START=100
NACL_RULE_END=199

# Block TTL in hours (auto-expiry)
BLOCK_TTL_HOURS=24

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=storage/froststream.log